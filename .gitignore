# ─── Node / TypeScript ────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Build output (root-anchored: these are output dirs, not source — e.g. src/core/build/ is a module)
/dist/
/build/
/out/
/lib/
/release/
*.tsbuildinfo

# Test / coverage
coverage/
.nyc_output/
*.lcov

# Caches
.cache/
.eslintcache
.npm/

# ─── Environment & secrets ────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.local

# ─── Project runtime artifacts (future) ───────────────────────────────────────
# Local working copies of user game data, generated packs, and backups must never
# be committed. These paths are reserved for when application code lands.
/.minecraft/
/instances/
/backups/
/tmp/
/.modpack-assistant/
*.mrpack

# ─── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── Editors / IDEs ───────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
.idea/
*.swp
*.swo
*~
*.sublime-workspace
.history/
