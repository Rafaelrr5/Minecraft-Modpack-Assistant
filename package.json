{
  "name": "minecraft-modpack-assistant",
  "version": "0.1.0",
  "description": "An AI assistant that guides anyone through the entire Minecraft modpack lifecycle, staying one step ahead of conflicts and crashes.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "mpa": "dist/cli/main.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "node --test \"src/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm run build && npm test",
    "cli": "node src/cli/main.ts"
  },
  "keywords": [
    "minecraft",
    "modpack",
    "modrinth",
    "packwiz",
    "cli",
    "assistant"
  ],
  "dependencies": {
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.21.0"
  }
}
