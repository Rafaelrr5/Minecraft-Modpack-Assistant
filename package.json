{
  "name": "minecraft-modpack-assistant",
  "version": "0.1.0",
  "description": "An AI assistant that guides anyone through the entire Minecraft modpack lifecycle, staying one step ahead of conflicts and crashes.",
  "license": "MIT",
  "author": {
    "name": "Rafael Rocha Ribeiro",
    "email": "faelrribeiro3@gmail.com"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "mpa": "dist/cli/main.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "node --test \"src/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm run build && npm test",
    "cli": "node src/cli/main.ts",
    "desktop:dev": "electron-vite dev",
    "desktop:build": "electron-vite build",
    "desktop:dist": "electron-vite build && electron-builder --publish never && node scripts/checksum-release.mjs",
    "desktop:typecheck": "tsc -p src/desktop/tsconfig.json",
    "desktop:smoke": "electron-vite build && node scripts/desktop-smoke.mjs",
    "desktop:e2e": "electron-vite build && node scripts/desktop-e2e.mjs",
    "desktop:screenshot": "electron-vite build && node scripts/desktop-screenshot.mjs",
    "desktop:icon": "node scripts/generate-icon.mjs"
  },
  "keywords": [
    "minecraft",
    "modpack",
    "modrinth",
    "packwiz",
    "cli",
    "assistant"
  ],
  "dependencies": {
    "smol-toml": "^1.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.4",
    "electron-builder": "^26.16.1",
    "electron-vite": "^5.0.0",
    "eslint": "^9.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.21.0",
    "vite": "^7.3.6"
  }
}
